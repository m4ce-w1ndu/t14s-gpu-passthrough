<!--
  Windows 11 guest, stage 2: iGPU passthrough. Same name/UUID as vm/win11.xml, so the TPM state
  and UEFI variables carry over (switch between the two with ./vm-mode.sh).

  The host desktop is stopped while this runs, so the guest gets 12 vCPUs: physical cores 2-7
  (host CPUs 4-15) as 6 cores x 2 threads. QEMU emulator threads: core 1 (CPUs 2-3). Core 0: host.

  The GPU (05:00.0) and its HDMI audio (05:00.1) are bound to vfio-pci by the libvirt hook
  (hooks/qemu.d/t14s-gpu), hence managed='no'. The VBIOS sits on the GPU, the AMD GOP driver on the
  audio function. Built-in keyboard, TrackPoint and touchpad come in over evdev; press both Ctrl
  keys to toggle the keyboard grab.
-->
<domain type='kvm'>
  <name>win11</name>
  <uuid>fc87053d-a69c-428b-9baa-d9ba2945b257</uuid>
  <title>Windows 11 (T14s) - iGPU passthrough</title>
  <memory unit='GiB'>6</memory>
  <currentMemory unit='GiB'>6</currentMemory>
  <vcpu placement='static'>12</vcpu>
  <cputune>
    <vcpupin vcpu='0' cpuset='4'/>
    <vcpupin vcpu='1' cpuset='5'/>
    <vcpupin vcpu='2' cpuset='6'/>
    <vcpupin vcpu='3' cpuset='7'/>
    <vcpupin vcpu='4' cpuset='8'/>
    <vcpupin vcpu='5' cpuset='9'/>
    <vcpupin vcpu='6' cpuset='10'/>
    <vcpupin vcpu='7' cpuset='11'/>
    <vcpupin vcpu='8' cpuset='12'/>
    <vcpupin vcpu='9' cpuset='13'/>
    <vcpupin vcpu='10' cpuset='14'/>
    <vcpupin vcpu='11' cpuset='15'/>
    <emulatorpin cpuset='2-3'/>
  </cputune>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <firmware>
      <feature enabled='yes' name='secure-boot'/>
      <feature enabled='no' name='enrolled-keys'/>
    </firmware>
  </os>
  <features>
    <acpi/>
    <apic/>
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <runtime state='on'/>
      <synic state='on'/>
      <stimer state='on'/>
      <reset state='on'/>
      <vendor_id state='on' value='t14spassthru'/>
      <frequencies state='on'/>
      <tlbflush state='on'/>
      <ipi state='on'/>
    </hyperv>
    <vmport state='off'/>
    <smm state='on'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' clusters='1' cores='6' threads='2'/>
    <cache mode='passthrough'/>
    <feature policy='require' name='topoext'/>
  </cpu>
  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2' cache='none' io='native' discard='unmap'/>
      <source pool='default' volume='win11.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <boot order='1'/>
    </disk>
    <disk type='volume' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source pool='default' volume='virtio-win.iso'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
    </disk>

    <controller type='usb' model='qemu-xhci' ports='15'/>
    <controller type='sata' index='0'/>

    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>

    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <!-- iGPU: VBIOS from ACPI VFCT -->
    <hostdev mode='subsystem' type='pci' managed='no'>
      <source>
        <address domain='0x0000' bus='0x05' slot='0x00' function='0x0'/>
      </source>
      <rom file='/var/lib/libvirt/vbios/vbios_1002_1638.bin'/>
      <address type='pci' domain='0x0000' bus='0x06' slot='0x00' function='0x0' multifunction='on'/>
    </hostdev>
    <!-- iGPU HDMI/DP audio, carrying the AMD GOP driver as its option ROM -->
    <hostdev mode='subsystem' type='pci' managed='no'>
      <source>
        <address domain='0x0000' bus='0x05' slot='0x00' function='0x1'/>
      </source>
      <rom file='/var/lib/libvirt/vbios/AMDGopDriver.rom'/>
      <address type='pci' domain='0x0000' bus='0x06' slot='0x00' function='0x1'/>
    </hostdev>
    <video>
      <model type='none'/>
    </video>

    <!-- Built-in input devices (stable by-path names) -->
    <input type='evdev'>
      <source dev='/dev/input/by-path/platform-i8042-serio-0-event-kbd' grab='all' grabToggle='ctrl-ctrl' repeat='on'/>
    </input>
    <input type='evdev'>
      <source dev='/dev/input/by-path/platform-i8042-serio-1-event-mouse'/>
    </input>
    <input type='evdev'>
      <source dev='/dev/input/by-path/platform-AMDI0010:02-event-mouse'/>
    </input>
    <input type='mouse' bus='virtio'/>
    <input type='keyboard' bus='virtio'/>

    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
    </rng>
    <memballoon model='none'/>
  </devices>
</domain>
